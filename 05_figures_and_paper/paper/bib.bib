   journal = {European Journal of Information Systems},
   keywords = {Action research,Project abandonment factors,Project failure factors,Strategic scanning,System abandonment factors},
   pages = {371-386},
   title = {Strategic scanning project failure and abandonment factors: Lessons learned},
   volume = {17},
   year = {2008},
}

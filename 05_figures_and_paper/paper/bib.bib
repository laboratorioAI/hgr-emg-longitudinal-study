@article{Masoud1996,
   abstract = {This study compared the relationships between organizational context and the designs of environmental scanning systems for organizations with effective and ineffective scanning systems. The study analyzed data from over 100 North American business organizations. Results indicate that organizations with effective scanning systems tend to align their scanning designs with the requirements of their context. On the other hand, the results show that organizations with ineffective scanning systems typically fail to exhibit the requisite level of alignment between contexts and scanning design.},
   author = {Masoud Yasai-Ardekani and Paul C. Nystrom},
